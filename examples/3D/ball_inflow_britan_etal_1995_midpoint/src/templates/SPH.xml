<sphInput>
    <Definitions>
        <Define name="__DR_FACTOR__" value="0.5 * sqrt(2)" evaluate="true"/>
    </Definitions>
    <Variables>
        <Variable name="g" type="vec" value="0.0, 0.0, -{{G}}, 0.0" />
        <Variable name="dr" type="float" value="{{DR}}" />
        <Variable name="hfac" type="float" value="{{HFAC}}" />
        <Variable name="h" type="float" value="hfac * dr" />
        <Variable name="cs" type="float" value="{{CS}}" />
        <Variable name="courant" type="float" value="{{COURANT}}" />
        <Variable name="domain_min" type="vec" value="{{DOMAIN_MIN}}" />
        <Variable name="domain_max" type="vec" value="{{DOMAIN_MAX}}" />
        <Variable name="iter_midpoint_max" type="unsigned int" length="1" value="15"/>
        <Variable name="relax_midpoint" type="float" length="1" value="0.0"/>
        <Variable name="Residual_midpoint_max" type="float" length="1" value="1.e-6" symbol="E_{\Delta t}^{max}"/>
        <Variable name="Residual_midpoint_mindec" type="float" length="1" value="1.0 / 5.0" symbol="E_{\Delta t} / E_{\Delta t,m-1}"/>
        <Variable name="relax_midpoint_inc" type="float" length="1" value="0.1" symbol="f_{\Delta t,0}"/>
        <Variable name="L" type="float" value="{{L}}" />
        <Variable name="B" type="float" value="{{B}}" />        
        <Variable name="H" type="float" value="{{H}}" />
        <Variable name="R" type="float" value="{{R}}" />
        <Variable name="RHOP" type="float" value="{{RHOP}}" />
        <Variable name="n_ball" type="unsigned int" value="{{n_ball}}" />
                <!-- Inlet boundary condition -->
        <Variable name="inflow_r" type="vec" value="-0.5*{{L}} + {{DR}} + support*h, -0.5*{{B}}, -0.5*{{H}}, 0.0" />
        <Variable name="inflow_ru" type="vec" value="0.0, {{B}}, 0.0, 0.0" />
        <Variable name="inflow_rv" type="vec" value="0.0, 0.0, {{H}}, 0.0" />
        <Variable name="inflow_rFS" type="vec" value="-0.5*{{L}}, 0.0, 0.0, 0.0" />
        <Variable name="inflow_N" type="uivec2" value="{{NY}}, {{NZ}}" />
        <Variable name="inflow_n" type="vec" value="1.0, 0.0, 0.0, 0.0" />
        <Variable name="inflow_U" type="float" value="{{U2}}" />
        <Variable name="inflow_rho" type="float" value="{{RHO2}}" />
        <Variable name="inflow_eint" type="float" value="{{E2}}" />
        <Variable name="inflow_gamma" type="float" value="{{GAMMA}}" />
    </Variables>
</sphInput>
