<sphInput>
    <!-- Wave heigh sensors. -->
    <Variables>
        <!-- Sensors result -->
        <Variable name="H1" type="float" value="0.0" />
        <Variable name="H2" type="float" value="0.0" />
        <Variable name="H3" type="float" value="0.0" />
        <Variable name="H4" type="float" value="0.0" />
        <!-- Helper array to nullify the z coordinates of the particles far away
        from the sensor. -->
        <Variable name="h_sensory" type="float*" length="N" />
        <!-- Definition of the points where the sensor should compute -->
        <Variable name="h_sensorx" type="float" value="0.0" />
    </Variables>

    <Tools>
        <!-- H1 computation -->
        <Tool action="insert" before="TimeStep" type="set_scalar" name="H1 x" in="h_sensorx" value="{{X_PROBE}}"/>
        <Tool action="insert" after="H1 x" type="kernel" name="H1 y" path="h_sensor.cl"/>
        <Tool action="insert" after="H1 y" type="reduction" name="H1" in="h_sensory" out="H1" null="-INFINITY">
            c = (a &lt; b) ? b : a;
        </Tool>
        <!-- H2 computation -->
        <Tool action="insert" before="TimeStep" type="set_scalar" name="H2 x" in="h_sensorx" value="{{X_PROBE}} + 1.5"/>
        <Tool action="insert" after="H2 x" type="kernel" name="H2 y" path="h_sensor.cl"/>
        <Tool action="insert" after="H2 y" type="reduction" name="H2" in="h_sensory" out="H2" null="-INFINITY">
            c = (a &lt; b) ? b : a;
        </Tool>
        <!-- H3 computation -->
        <Tool action="insert" before="TimeStep" type="set_scalar" name="H3 x" in="h_sensorx" value="{{X_PROBE}} + 3.0"/>
        <Tool action="insert" after="H3 x" type="kernel" name="H3 y" path="h_sensor.cl"/>
        <Tool action="insert" after="H3 y" type="reduction" name="H3" in="h_sensory" out="H3" null="-INFINITY">
            c = (a &lt; b) ? b : a;
        </Tool>
        <!-- H4 computation -->
        <Tool action="insert" before="TimeStep" type="set_scalar" name="H4 x" in="h_sensorx" value="{{X_PROBE}} + 4.5"/>
        <Tool action="insert" after="H4 x" type="kernel" name="H4 y" path="h_sensor.cl"/>
        <Tool action="insert" after="H4 y" type="reduction" name="H4" in="h_sensory" out="H4" null="-INFINITY">
            c = (a &lt; b) ? b : a;
        </Tool>
    </Tools>

    <Reports>
        <Report type="screen" name="H sensors" fields="H1, H2, H3, H4" color="red" bold="false"/>
        <Report type="file" name="H file" fields="t, H1, H2, H3, H4" path="sensors_h.out"/>
    </Reports>
</sphInput>
