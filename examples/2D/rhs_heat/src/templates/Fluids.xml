<sphInput>
    <ParticlesSet n="{{N}}">
        <Scalar name="refd" value="0.0" />
        <Scalar name="visc_dyn" value="0.0" />
        <!--<Scalar
        name="gamma" value="{{GAMMA}}" />-->
        <Load format="FastASCII" file="Fluid.dat"
            fields="r, normal, u, dudt, 
        rho, drhodt, 
        eint, deintdt, 
        z, 
        y_H2, dy_H2dt, 
        y_O2, dy_O2dt, 
        y_N2, dy_N2dt, 
        y_H2O, dy_H2Odt, 
        m, 
        nu, xi, 
        imove" />
        <Save format="VTK" file="output"
            fields="r, normal, u, dudt, rho, drhodt, eint, deintdt, z, y_H2, dy_H2dt, y_O2, dy_O2dt, y_N2, dy_N2dt, y_H2O, dy_H2Odt, m, p, nu, xi, T, imove" />
    </ParticlesSet>
</sphInput>