<sphInput>
    <ParticlesSet n="{{N}}">
        <Scalar name="refd" value="0.0" />
        <Scalar name="visc_dyn" value="0.0" />
        <!--<Scalar
        name="gamma" value="{{GAMMA}}" />-->
        <Load format="FastASCII" file="Fluid.dat"
            fields="r, normal, u, dudt, 
        rho, drhodt, 
        eint, deintdt, 
        z, 
        ys,
        dysdt,
        m, 
        nu, xi, 
	Ds,
        imove" />
        <Save format="VTK" file="output"
            fields="r, normal, u, dudt, rho, drhodt, eint, deintdt, z, ys, dysdt, m, p, nu, xi, T, Ds, imove" />
    </ParticlesSet>
</sphInput>
