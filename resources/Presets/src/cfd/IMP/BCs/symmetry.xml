<?xml version="1.0" ?>

<!-- symmetry.xml
Infinite symmetry plane.
This preset is designed to be loaded after cfd/IMP.xml and basic/domain.xml

To use it, just include this file, and later set the values for the variables:
symmetry_r = Position of the symmetry plane
symmetry_n = Normal of the symmetry plane (It should be normalized)

In order to add several symmetry planes, just include this file setting a
prefix, for instance:
<Include file="symmetry.xml" prefix="left_"/>
<Include file="symmetry.xml" prefix="right_"/>
<Tools>
    <Tool action="insert" before="left_imp symmetry init*" type="set_scalar" name="left_symmetry_r" in="symmetry_r" value="-1.0, 0.0, 0.0, 0.0"/>
    <Tool action="insert" before="left_imp symmetry init*" type="set_scalar" name="left_symmetry_n" in="symmetry_n" value="-1.0, 0.0, 0.0, 0.0"/>
    <Tool action="insert" before="right_imp symmetry init*" type="set_scalar" name="right_symmetry_r" in="symmetry_r" value="1.0, 0.0, 0.0, 0.0"/>
    <Tool action="insert" before="right_imp symmetry init*" type="set_scalar" name="right_symmetry_n" in="symmetry_n" value="1.0, 0.0, 0.0, 0.0"/>
</Tools>
-->

<sphInput>
    <Include file="tools/symmetry_placeholder.xml" prefix=""/>

    <Variables>
        <!-- position and normal of the symmetry plane -->
        <Variable name="symmetry_r" type="vec" value="0.0, 0.0, 0.0, 0.0" />
        <Variable name="symmetry_n" type="vec" value="1.0, 0.0, 0.0, 0.0" />
        <!-- flag to identify the particles to be symmetrized -->
        <Variable name="imirror" type="unsigned int*" length="N" />
        <Variable name="imirror_perm" type="size_t*" length="N" />
        <Variable name="imirror_invperm" type="size_t*" length="N" />
        <!-- Index of the source particle of each mirrored one. Useful to make
             extensions to this module. N for all particles that are not
             mirrored
        -->
        <Variable name="mirror_src" type="size_t*" length="N" />
        <Variable name="mirror_src_in" type="size_t*" length="N" />
        <!-- Internal variable to check there are enough buffer particles -->
        <Variable name="required_nbuffer" type="size_t" />        
    </Variables>

    <Tools>
        <!-- Reinit the array of source particles -->
        <Tool name="imp symmetry reset mirror_src" action="try_remove" type="dummy"/>
        <Tool name="imp symmetry reset mirror_src" action="insert" at="0" type="set" in="mirror_src" value="N" once="true"/>

        <!-- Detect the particles to be mirrored -->
        <Tool name="imp symmetry init detect" action="insert" before="*point imp Symmetry" type="kernel" path="../../../../Scripts/cfd/IMP/BCs/Symmetry/Mirror.cl" entry_point="detect"/>

        <!-- Sort imirror so we can consume buffer particles in a consistent way -->
        <Tool name="imp symmetry sort" action="insert" before="*point imp Symmetry" type="radix-sort" in="imirror" perm="imirror_perm" inv_perm="imirror_invperm"/>

        <!-- Prepare the particles buffer -->
        <Tool name="Set buffer" action="insert" before="*point imp Symmetry" type="dummy" />
        <Tool name="imp symmetry count buffer particles" action="insert" before="*point imp Symmetry" type="reduction" in="imirror" out="required_nbuffer" null="0">
            c = a + b;
        </Tool>
        <Tool name="imp symmetry check buffer particles" action="insert" before="*point imp Symmetry" type="assert" condition="nbuffer &gt;= required_nbuffer"/>

        <!-- Feed the system with the new particles -->
        <Tool name="imp symmetry feed" action="insert" before="*point imp Symmetry" type="kernel" path="../../../../Scripts/cfd/IMP/BCs/Symmetry/Mirror.cl" entry_point="feed"/>
        <Tool name="imp symmetry set" action="insert" before="*point imp Symmetry" type="kernel" path="../../../../Scripts/cfd/IMP/BCs/Symmetry/Mirror.cl" entry_point="set"/>
        <Tool name="imp symmetry backup mirror_src" action="insert" before="* imp Symmetry" type="copy" in="mirror_src" out="mirror_src_in"/>

        <!-- Keep a track of the mirrored particles sources -->
        <Tool name="imp symmetry sort" action="insert" before="*point Sort" type="kernel" path="../../../../Scripts/cfd/IMP/BCs/Symmetry/Mirror.cl" entry_point="sort"/>

        <!-- Remove the symmetrized particles, i.e. the ones at the other side
             of the mirror -->
        <Tool name="imp symmetry init clean" action="insert" before="imp Inpoint" type="kernel" path="../../../../Scripts/cfd/IMP/BCs/Symmetry/Mirror.cl" entry_point="drop"/>
        <Tool name="imp symmetry init clean" action="insert" before="imp Outpoint" type="kernel" path="../../../../Scripts/cfd/IMP/BCs/Symmetry/Mirror.cl" entry_point="drop"/>
    </Tools>

    <Include file="../../../basic/setBuffer.xml" when="end"/>
</sphInput>
