<?xml version="1.0"?>
<!-- symmetry.xml
Symmetrization of the terms for heat transfer.
For most logical application, use this module in conjunction with the
symmetrization of the mass fractions. The latter is carried out in
cfd/species/symmetry.xml.
Ideal gas simmetry will take care of symetrization of energy.
-->

<sphInput>
    <Tools>
        <Tool action="insert" after="*cfd symmetry set" name="cfd symmetry set heat" type="kernel"
            path="../../../Scripts/cfd/heat/symmetry/Mirror.cl" entry_point="feed" />
    </Tools>
</sphInput>
