<?xml version="1.0" ?>

<!-- reactive_trigger.xml
Trigger the reaction locally, kind of numerical spark plug
-->

<sphInput>
    <Variables>
        <Variable name="trigger" type="int*" length="N" />
        <Variable name="trigger_in" type="int*" length="N" />
    </Variables>


    <Tools>
        <Tool action="insert" name="Backup trigger" before="sort stage1,sort stage2" type="copy" in="trigger"
            out="trigger_in" />

        <Tool action="insert" after="sort stage1,sort stage2" name="sort trigger" type="kernel"
            entry_point="entry" path="../../../Scripts/cfd/reactive/Sort_trigger.cl" />
    </Tools>
</sphInput>
