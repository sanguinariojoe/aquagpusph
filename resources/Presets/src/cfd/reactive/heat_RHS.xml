<?xml version="1.0" ?>

<!-- ideal_gas.xml
Replace the stiffened EOS by an ideal gas EOS with isotentropic expansion
-->

<sphInput>
    <Variables>

        <Variable name="kappa" type="float*" length="N" />
        <Variable name="rhs_qdot" type="float*" length="N" />
        
    </Variables>

    <Tools>
        
        <Tool action="insert" after="Sort" type="set" name="Reinit rhs qdot" in="rhs_qdot" value="0.f"/>

        <Tool action="insert" before="Rates" type="kernel" name="rhs y rates" path="../../../Scripts/cfd/RHS_heat_transfer.cl"/>

    </Tools>
</sphInput>
