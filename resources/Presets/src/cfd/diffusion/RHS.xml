<?xml version="1.0"?>

<!-- RHS.xml
Introduced the Fick's Law of diffusion in the equations for multiple species.

This module needs that a type alias and definition of "species_t" is created
before loading it. It also needs a definition of "SPECIES_COMPONENT0".

See for instance cfd/species/gases/hydrogen_air_bulk.xml

Thus, this module shall be included AFTER that backend. e.g.

<Include file="resources/Presets/cfd/species/gases/hydrogen_air_bulk.xml" />
<Include file="resources/Presets/cfd/diffusion/RHS.xml" />
-->

<sphInput>
    <Variables>
        <Variable name="Ds" type="species_t*" length="N" />
        <Variable name="Ds_in" type="species_t*" length="N" />
        <Variable name="rhsy" type="species_t*" length="N" />
        
    </Variables>

    <Tools>
        <Tool action="insert" after="Sort" type="set" name="reinit rhs y" in="rhsy" value="(species_t)(0.f)" />

        <!-- This is for time being, until a more advanced transport model is programmed-->
        <Tool action="insert" name="Backup Ds" before="sort stage1,sort stage2" type="copy"
            in="Ds" out="Ds_in" />   

        <Tool action="insert" after="sort stage1,sort stage2" name="sort heat" type="kernel"
            entry_point="entry" path="../../../Scripts/cfd/diffusion/Sort.cl" />

        <Tool action="insert" before="Interactions" type="kernel" name="rhs y rates"
            path="../../../Scripts/cfd/diffusion/RHS_diffusion.cl" />

        <Tool action="insert" before="Rates" name="add increments gas multicomponents" type="kernel"
            entry_point="add" path="../../../Scripts/cfd/diffusion/add_increments.cl" />

    </Tools>
</sphInput>
