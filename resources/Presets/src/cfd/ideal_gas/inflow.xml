<?xml version="1.0" ?>

<sphInput>
    <Variables>
        <Variable name="inflow_e" type="float" value="0.0" />
        <Variable name="inflow_rho" type="float" value="0.0" />
        <Variable name="inflow_gamma" type="float" value="0.0" />
    </Variables>    
    <Tools>
        <Tool name="cfd inflow feed energy" action="insert" before="Inflow" type="kernel" entry_point="feed" path="../../../Scripts/cfd/ideal_gas/Inflow/Inflow.cl"/>
                <!-- Now ensure that particles in the inflow are not affected by the interactions -->
        <Tool name="cfd inflow energy" action="insert" before="Rates" type="kernel" entry_point="rates" path="../../../Scripts/cfd/ideal_gas/Inflow/Inflow.cl"/>
    </Tools>
</sphInput>