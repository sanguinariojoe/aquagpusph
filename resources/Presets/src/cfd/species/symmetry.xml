<?xml version="1.0"?>
<!-- symmetry.xml
Symmetrization of the terms for species.

To use this module, just include it after cfd/species/species.xml and
cfd/symmetry.xml
-->

<sphInput>
    <Tools>
        <Tool action="insert" after="*cfd symmetry set" name="cfd symmetry set species" type="kernel"
            path="../../../Scripts/cfd/species/symmetry/Mirror.cl" entry_point="feed" />
    </Tools>
</sphInput>
