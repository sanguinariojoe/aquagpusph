<?xml version="1.0" ?>

<!-- deltaSPH.xml
delta-SPH is a method to reduce the pressure field noise through the
introduction of a diffusive term inside the mass conservation equation.

Such term is based in the computation of the pressure Laplacian.

In principle, the Laplacian is computed using the Morrison formula, and no
correction is added. However it is strongly recommended to add a correction
(since it will become inconsistent close to the boundaries):
  - If the pressure field will be heavily dominanted by the hidrostatic
  component, the simplified correction deltaSPH-simple.xml can be used.
  - Otherwise the MLS based correction deltaSPH-full.xml will be applied.

Remember that after including this preset, a new property for each particles set
should be imposed, the delta factor (in principle 0.0 or 1.0)
-->

<sphInput>
    <Variables>
        <Variable name="du_shift" type="vec*" length="N" />
		<Variable name="Uref" type="float" value="0.0" />
    </Variables>

    <Tools>
		<!-- We should get the minimum kernel length to recompute the time
        step -->
		<Tool action="insert" after="Sort" type="set" name="cfd Reinit du_shift" in="du_shift" value="VEC_ZERO"/>
		<Tool name="grad BI gamma" action="insert" after="grad gamma" type="kernel" path="BI_DeltaShepard.cl"/>
        <Tool name="du shift fluid" after="free surface region" type="kernel" action="insert" entry_point="drfluid" path="shifting.cl"/>
        <Tool name="du shift boundary" after="du shift fluid" type="kernel" action="insert" entry_point="drbound" path="shifting.cl"/>
        <Tool action="insert" after="du shift boundary" type="kernel" name="cfd du" entry_point="du" path="shifting.cl"/>
        <Tool action="insert" after="corrector" type="kernel" name="cfd shifting" entry_point="correct" path="shifting.cl"/>
        </Tools>
</sphInput>
