<?xml version="1.0" ?>
<sphInput>
    <Variables>
        <Variable length="N" name="r" symbol="r" type="vec*" />
        <Variable length="N" name="v" symbol="v" type="vec16*" />
        <Variable length="1" name="v_sum" symbol="v_s" type="vec16" />
        <Variable length="1" name="h" symbol="h" type="float" value="0.1"/>
    </Variables>
    <ParticlesSet n="500">
        <Load fields="r,v" file="particles.dat" format="FastASCII"/>
        <Save fields="r,v" file="set0" format="ASCII"/>
    </ParticlesSet>
    <Tools>
        <Tool action="add" name="python script" type="python" path="tool.py" />
        <Tool action="add" name="sum up" type="reduction" in="v" out="v_sum" null="VEC16_ZERO">
            c = a + b;
        </Tool>
        <Tool action="add" name="set tool" type="set" in="v" value="VEC16_ZERO"/>
        <Tool action="add" name="iter += 1" type="set_scalar" in="iter" value="iter + 1"/>
        <Tool action="add" name="performance" type="report_performance" color="white" bold="false" path="performance.json"/>
    </Tools>

    <Settings>
        <Device device="0" platform="0" type="ALL"/>
        <RootPath path="@RESOURCES_DIR@/.."/>
    </Settings>
    <Timing>
        <Option name="End" type="Steps" value="1"/>
    </Timing>
</sphInput>
