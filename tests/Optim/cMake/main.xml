<?xml version="1.0" ?>
<sphInput>
    <Variables>
        <Variable name="dt" type="float" symbol="\Delta t" value="1.0" />
        <Variable name="cs" type="float" symbol="c_s" value="1.0" />
        <Variable name="g" type="vec" value="0.0, 0.0, 0.0, 0.0" />
        <Variable name="p0" type="float" value="0.0" />
        <Variable name="h" type="float" value="0.008"/>
        <Variable name="refd" type="float*" length="n_sets" />

        <Variable name="imove" type="int*" length="N" />
        <Variable name="normal" type="vec*" length="N" />
        <Variable name="tangent" type="vec*" length="N" />
        <Variable name="binormal" type="vec*" length="N" />
        <Variable name="r" type="vec*" length="N" />
        <Variable name="u" type="vec*" length="N" />
        <Variable name="dudt" type="vec*" length="N" />
        <Variable name="rho" type="float*" length="N" />
        <Variable name="drhodt" type="float*" length="N" />
        <Variable name="m" type="float*" length="N" />

        <Variable name="id_in" type="size_t*" length="N" />
        <Variable name="iset_in" type="unsigned int*" length="N" />
        <Variable name="imove_in" type="int*" length="N" />
        <Variable name="r_in" type="vec*" length="N" />
        <Variable name="normal_in" type="vec*" length="N" />
        <Variable name="tangent_in" type="vec*" length="N" />
        <Variable name="u_in" type="vec*" length="N" />
        <Variable name="dudt_in" type="vec*" length="N" />
        <Variable name="rho_in" type="float*" length="N" />
        <Variable name="drhodt_in" type="float*" length="N" />
        <Variable name="m_in" type="float*" length="N" />

        <Variable name="r_min" type="vec" />
        <Variable name="r_max" type="vec" />
        <Variable name="p" type="float*" length="N" />

        <Variable name="nnc" type="unsigned int" value="3^(dims - 1)" />
        <Variable name="jhoc" type="svec2*" length="nnc * N" />

        <Variable name="n_neighs_legacy" type="unsigned int*" length="N" />
        <Variable name="n_neighs_optim" type="unsigned int*" length="N" />
        <Variable name="n_neighs_err" type="unsigned int*" length="N" />
        <Variable name="n_neighs_err_max" type="unsigned int" />

        <Variable name="grad_p" type="vec*" length="N" />
        <Variable name="div_u" type="float*" length="N" />
    </Variables>
    <Definitions>
        <Define evaluate="true" name="DIMS" value="dims"/>
        <Define evaluate="true" name="H" value="h"/>
        <Define evaluate="true" name="CONW" value="1/(h^dims)"/>
        <Define evaluate="true" name="CONF" value="1/(h^(dims+2))"/>
        <Define evaluate="true" name="SUPPORT" value="support"/>
        <Define evaluate="false" name="KERNEL_NAME" value="Wendland"/>
    </Definitions>
    <ParticlesSet n="252000">
        <Scalar name="refd" value="1"/>
        <Load fields="r,u,dudt,rho,drhodt,m,imove" file="Fluid.dat" format="FastASCII"/>
        <Save fields="r,u,dudt,rho,drhodt,m,imove" file="output" format="ASCII"/>
    </ParticlesSet>
    <Tools>
        <Tool action="add" name="predictor" type="kernel" entry_point="predictor" path="resources/Scripts/basic/time_scheme/euler.cl"/>
        <Tool action="add" name="Predictor" type="dummy"/>

        <!-- Link-list and particles sorting -->
        <Tool action="add" name="link-list" type="link-list" in="r_in"/>
        <Tool action="add" name="dump ihoc" type="report_dump" fields="ihoc" path="ihoc.data" />
        <Tool action="add" name="make neighbor chains" type="kernel" entry_point="neigh_chains" path="resources/Scripts/basic/neighs.cl"/>
        <Tool action="add" name="Link-List" type="dummy"/>

        <Tool action="add" name="Backup id" type="copy" in="id" out="id_in"/>
        <Tool action="add" name="Backup iset" type="copy" in="iset" out="iset_in"/>
        <Tool action="add" name="Backup imove" type="copy" in="imove" out="imove_in"/>
        <Tool action="add" name="Backup normal" type="copy" in="normal" out="normal_in"/>
        <Tool action="add" name="Backup tangent" type="copy" in="tangent" out="tangent_in"/>
        <Tool action="add" name="Backup m" type="copy" in="m" out="m_in"/>
        <Tool action="add" name="sort stage1" type="kernel" entry_point="stage1" path="resources/Scripts/basic/Sort.cl"/>
        <Tool action="add" name="sort stage2" type="kernel" entry_point="stage2" path="resources/Scripts/basic/Sort.cl"/>
        <Tool action="add" name="EOS" type="kernel" path="resources/Scripts/basic/EOS.cl"/>
        <Tool action="add" name="Binormal" type="kernel" path="resources/Scripts/basic/Binormal.cl"/>
        <Tool action="add" name="Sort" type="dummy"/>

        <!-- Count neighbors using both methodologies -->
        <Tool action="add" name="Neighs Legacy" type="kernel" entry_point="legacy" path="Neighs.cl"/>
        <Tool action="add" name="Neighs Optim" type="kernel" entry_point="optim" path="Neighs.cl"/>
        <Tool action="add" name="Neighs Error" type="kernel" entry_point="err" path="Neighs.cl"/>
        <Tool action="add" name="dump Neighs" type="report_dump" fields="n_neighs_legacy,n_neighs_optim" path="n_neighs.data" />
        <Tool action="add" name="Max Neighs Error" type="reduction" in="n_neighs_err" out="n_neighs_err_max" null="0">
            c = (a &gt; b) ? a : b;
        </Tool>
        <Tool action="add" name="prompt Max Neighs Error" type="report_screen" fields="n_neighs_err_max" bold="false" color="blue"/>

        <!-- Carry out interactions using both methodologies -->
        <Tool action="add" name="Legacy" type="kernel" entry_point="legacy" path="Interactions.cl"/>
        <Tool action="add" name="Optim" type="kernel" entry_point="optim" path="Interactions.cl"/>

        <!-- Finish the job -->
        <Tool in="iter" name="iter += 1" once="false" type="set_scalar" value="iter + 1"/>
        <Tool action="add" name="performance" type="report_performance" color="white" bold="false" path="performance.json"/>
    </Tools>

    <Settings>
        <Device device="0" platform="0" type="ALL"/>
        <RootPath path="@RESOURCES_DIR@/.."/>
    </Settings>
    <Timing>
        <Option name="End" type="Steps" value="1"/>
    </Timing>
</sphInput>
